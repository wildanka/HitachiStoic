# Copy to .env and fill in. .env is gitignored - never commit it.

# Ollama hosted service. Get a key at https://ollama.com/settings/keys
# Leave this unset/empty to use a local Ollama instead.
OLLAMA_API_KEY=

# Optional overrides. Defaults follow whether OLLAMA_API_KEY is set:
#   key set   -> https://ollama.com          + gpt-oss:120b-cloud
#   key unset -> http://localhost:11434      + qwen3:4b
# OLLAMA_URL=
# OLLAMA_MODEL=
# PORT=3000
